.DS_Store
.tmp/
.claude/histories
.claude/settings.local.json
.codex-runs/
__pycache__/
.pytest_cache/
.ruff_cache/
*.ndjson
!tests/facebook/fixtures/*.ndjson
!tests/reddit/fixtures/*.ndjson
!tests/threads/fixtures/*.ndjson
!tests/twitter/fixtures/*.ndjson
# The naver-blog suite keeps whole fixture sets in subdirectories, so this has to
# reach into them: a top-level-only exception left them untracked and CI failed
# on eight tests that pass locally.
!tests/naver_blog/fixtures/**/*.ndjson

# SEC requester identity stays local.
.claude/skills/sec/Scripts/.env

# Finviz keeps its locked runtime local.
.claude/skills/finviz/.venv/

# yfinance keeps the observations it saves in its own data folder.
.claude/skills/yfinance/data/

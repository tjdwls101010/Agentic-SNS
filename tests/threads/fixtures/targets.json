{
  "about": "Input checks and target rules (appendix A 7, 9, 10). routes: whether a local Threads path may be read at all. targets: what a user-typed target normalizes to for a command kind (user or post), or that it is refused before any request. shortcodes: the post id a shortcode encodes, computed with no request. All handles and codes are synthetic.",
  "routes": {
    "item": "7",
    "fact": "Only the read surface may be requested: /, /search, /following, /liked, /saved, /@<name> with an optional tab (threads, replies, reposts, media) or /post/<code>, and /t/<code>. A query string is allowed; anything else, a scheme, a host, //, a backslash or a fragment is refused.",
    "cases": [
      {"path": "/", "allowed": true},
      {"path": "/search?q=example&serp_type=default", "allowed": true},
      {"path": "/following", "allowed": true},
      {"path": "/following/", "allowed": true},
      {"path": "/liked", "allowed": true},
      {"path": "/saved/", "allowed": true},
      {"path": "/@example.user", "allowed": true},
      {"path": "/@example.user/replies", "allowed": true},
      {"path": "/@example.user/media/", "allowed": true},
      {"path": "/@example.user/post/DAbc_-12", "allowed": true},
      {"path": "/t/DAbc_-12", "allowed": true},
      {"path": "/activity", "allowed": false, "why": "not a read surface"},
      {"path": "/settings/account", "allowed": false, "why": "not a read surface"},
      {"path": "/@example.user/followers", "allowed": false, "why": "not a profile tab this reader reads by route"},
      {"path": "/@example.user/post/DAbc/likes", "allowed": false, "why": "below a post is not a read route"},
      {"path": "//evil.example/", "allowed": false, "why": "network-path reference"},
      {"path": "https://www.threads.com/", "allowed": false, "why": "a URL, not a local path"},
      {"path": "@example.user", "allowed": false, "why": "must start with /"},
      {"path": "/@exa\\mple", "allowed": false, "why": "backslash"},
      {"path": "/@example.user#top", "allowed": false, "why": "fragment"}
    ]
  },
  "targets": {
    "item": "9",
    "fact": "Hosts are threads.com, www.threads.com, threads.net and www.threads.net, with or without a scheme; no port and no user info. A handle is [A-Za-z0-9_.]{1,30}, lowercased; activity, settings, search, liked and saved are reserved, not handles. A profile URL's tab suffix selects that tab. A post is /@<name>/post/<code>, /t/<code> or a bare shortcode [A-Za-z0-9_-]+; the shortcode keeps its case.",
    "cases": [
      {"kind": "user", "input": "@Example.User", "normalized": {"username": "example.user", "path": "/@example.user", "tab": ""}},
      {"kind": "user", "input": "example_user.2", "normalized": {"username": "example_user.2", "path": "/@example_user.2", "tab": ""}},
      {"kind": "user", "input": "https://www.threads.com/@example.user", "normalized": {"username": "example.user", "path": "/@example.user", "tab": ""}},
      {"kind": "user", "input": "https://threads.net/@example.user/", "normalized": {"username": "example.user", "path": "/@example.user", "tab": ""}},
      {"kind": "user", "input": "threads.com/@example.user/replies", "normalized": {"username": "example.user", "path": "/@example.user", "tab": "replies"}},
      {"kind": "user", "input": "https://www.threads.net/@example.user/reposts", "normalized": {"username": "example.user", "path": "/@example.user", "tab": "reposts"}},
      {"kind": "user", "input": "@activity", "refused": true, "why": "reserved name"},
      {"kind": "user", "input": "settings", "refused": true, "why": "reserved name"},
      {"kind": "user", "input": "https://www.threads.com/search", "refused": true, "why": "reserved route"},
      {"kind": "user", "input": "@liked", "refused": true, "why": "reserved name"},
      {"kind": "user", "input": "@saved", "refused": true, "why": "reserved name"},
      {"kind": "user", "input": "@bad-name", "refused": true, "why": "hyphen is not a handle character"},
      {"kind": "user", "input": "@abcdefghijklmnopqrstuvwxyz12345", "refused": true, "why": "31 characters, more than 30"},
      {"kind": "user", "input": "https://www.threads.com:8443/@example.user", "refused": true, "why": "port"},
      {"kind": "user", "input": "https://someone:pw@www.threads.com/@example.user", "refused": true, "why": "user info"},
      {"kind": "user", "input": "https://www.instagram.com/example.user", "refused": true, "why": "not a Threads host"},
      {"kind": "user", "input": "https://threads.com.evil.example/@example.user", "refused": true, "why": "not a Threads host"},
      {"kind": "user", "input": "ftp://www.threads.com/@example.user", "refused": true, "why": "scheme"},
      {"kind": "user", "input": "https://www.threads.com/@example.user/post/DAbc_-12", "refused": true, "why": "a post URL, not a profile"},
      {"kind": "post", "input": "https://www.threads.com/@Example.User/post/DAbc_-12", "normalized": {"username": "example.user", "code": "DAbc_-12", "path": "/@example.user/post/DAbc_-12"}},
      {"kind": "post", "input": "threads.net/@example.user/post/DAbc_-12/", "normalized": {"username": "example.user", "code": "DAbc_-12", "path": "/@example.user/post/DAbc_-12"}},
      {"kind": "post", "input": "https://www.threads.net/t/DAbc_-12", "normalized": {"username": "", "code": "DAbc_-12", "path": "/t/DAbc_-12"}},
      {"kind": "post", "input": "/t/DAbc_-12", "normalized": {"username": "", "code": "DAbc_-12", "path": "/t/DAbc_-12"}},
      {"kind": "post", "input": "DAbc_-12", "normalized": {"username": "", "code": "DAbc_-12", "path": "/t/DAbc_-12"}},
      {"kind": "post", "input": "https://www.threads.com/@example.user", "refused": true, "why": "a profile URL, not a post"},
      {"kind": "post", "input": "https://www.threads.com/@example.user/post/", "refused": true, "why": "no shortcode"},
      {"kind": "post", "input": "https://www.threads.com/@example.user/post/DAbc/media", "refused": true, "why": "not a post route"},
      {"kind": "post", "input": "DAbc 12", "refused": true, "why": "whitespace"},
      {"kind": "post", "input": "example.user", "refused": true, "why": "a dot is not a shortcode character"},
      {"kind": "post", "input": "https://www.threads.com:444/t/DAbc", "refused": true, "why": "port"}
    ]
  },
  "shortcodes": {
    "item": "10",
    "fact": "A shortcode is the post id written in base64url digits, most significant first: A-Z are 0-25, a-z 26-51, 0-9 52-61, - is 62 and _ is 63. The id needs no request. Expected values are hand-computed.",
    "cases": [
      {"code": "A", "post_id": "0"},
      {"code": "B", "post_id": "1"},
      {"code": "-", "post_id": "62"},
      {"code": "_", "post_id": "63"},
      {"code": "BA", "post_id": "64", "worked": "1*64 + 0"},
      {"code": "__", "post_id": "4095", "worked": "63*64 + 63"},
      {"code": "CAB", "post_id": "8193", "worked": "2*64^2 + 0*64 + 1"},
      {"code": "Dz-", "post_id": "15614", "worked": "3*4096 + 51*64 + 62"},
      {"code": "DAAAAAAAAAA", "post_id": "3458764513820540928", "worked": "3*64^10 = 3*2^60"},
      {"code": "DAAAAAAAAAB", "post_id": "3458764513820540929", "worked": "3*2^60 + 1"}
    ]
  }
}

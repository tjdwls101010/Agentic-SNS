#!/usr/bin/env python3
"""Live-only Aside bridge: reserve one slot in a shared ledger, then run the real Aside with the same arguments.

The ledger (THREADS_LIVE_LEDGER, default ~/.cache/threads-skill/live-validation-<date>.json) is shared by every CLI
process a live run starts and is locked while a slot is reserved, so concurrent processes cannot overrun the cap
(THREADS_LIVE_CAP, default 30). A refused call exits 1 without contacting Aside, which the CLI reports as an Aside
failure. The real binary is THREADS_LIVE_ASIDE, else `aside` on PATH.
"""
import fcntl
import json
import os
import re
import shutil
import sys
from datetime import date
from pathlib import Path

default = Path.home() / '.cache/threads-skill' / f'live-validation-{date.today().isoformat()}.json'
ledger = Path(os.environ.get('THREADS_LIVE_LEDGER') or default)
cap = int(os.environ.get('THREADS_LIVE_CAP') or 30)
ledger.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
source = sys.argv[-1]
snippet = re.search(r'// threads-snippet: (\w+)', source)
args = json.JSONDecoder().raw_decode(source.removeprefix('const ARGS = '))[0] if source.startswith('const ARGS') else {}
with ledger.with_suffix('.lock').open('a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    state = json.loads(ledger.read_text()) if ledger.exists() else {'requests': 0, 'calls': []}
    if state['requests'] >= cap:
        print(f'live bridge: cumulative cap of {cap} requests reached; nothing was sent', file=sys.stderr)
        sys.exit(1)
    state['requests'] += 1
    state['calls'].append({'snippet': snippet[1] if snippet else None, 'path': args.get('path'),
                           'operation': args.get('name'), 'after': bool((args.get('variables') or {}).get('after'))})
    ledger.write_text(json.dumps(state))
    ledger.chmod(0o600)
real = os.environ.get('THREADS_LIVE_ASIDE') or shutil.which('aside')
if not real or Path(real).resolve() == Path(__file__).resolve():
    print('live bridge: no real Aside binary', file=sys.stderr)
    sys.exit(1)
os.execv(real, [real, *sys.argv[1:]])

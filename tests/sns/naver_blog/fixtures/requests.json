 "redirects": {
  "item": "6, P2 R13",
  "fact": "A domain address answers not_exist_blog; one hop to blog.naver.com/{id} names the canonical blog id: in a 3xx location's blogId, or (as observed for an ordinary blog) in the 200 frameset page's var blogId and its mainFrame src. The id must match the blog-id pattern; a location off the read surface is drift; 404 means no such blog.",
  "cases": [
   {
    "status": 302,
    "location": "https://blog.naver.com/PostList.naver?blogId=canonical_id",
    "canonical": "canonical_id"
   },
   {
    "status": 302,
    "location": "https://evil.example/PostList.naver?blogId=x",
    "outcome": {
     "code": 6,
     "reason": "drift"
    }
   },
   {
    "status": 200,
    "body": "<script>var blogId = 'canonical_id'; var blogURL = 'https://blog.naver.com';</script><iframe id=\"mainFrame\" src=\"/PostList.naver?blogId=canonical_id&widgetTypeCall=true\"></iframe>",
    "canonical": "canonical_id"
   },
   {
    "status": 200,
    "body": "<script>var blogId = 'bad id';</script>",
    "outcome": {
     "code": 6,
     "reason": "drift"
    }
   },
   {
    "status": 404,
    "body": "<html>없는 블로그</html>",
    "outcome": {
     "code": 9,
     "reason": "not_exist_blog"
    }
   }
  ]
 }

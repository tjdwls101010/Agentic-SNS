 "headers": {
  "item": "1",
  "fact": "Naver's only header contract is a referer per host (apis.naver.com takes m.blog's). The user-agent is the REPL's own (a real browser version); a hand-written one is a mismatched fingerprint. accept follows what is asked for: json, html or an image. redirect is always manual.",
  "cases": [
   {
    "host": "m.blog.naver.com",
    "accept": "json",
    "referer": "https://m.blog.naver.com/",
    "accept_header": "application/json, text/plain, */*"
   },
   {
    "host": "m.blog.naver.com",
    "accept": "html",
    "referer": "https://m.blog.naver.com/",
    "accept_header": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
   },
   {
    "host": "section.blog.naver.com",
    "accept": "json",
    "referer": "https://section.blog.naver.com/"
   },
   {
    "host": "apis.naver.com",
    "accept": "json",
    "referer": "https://m.blog.naver.com/"
   },
   {
    "host": "blog.naver.com",
    "accept": "html",
    "referer": "https://blog.naver.com/"
   },
   {
    "host": "naver.me",
    "accept": "html",
    "referer": null
   },
   {
    "host": "mblogthumb-phinf.pstatic.net",
    "accept": "image",
    "referer": null,
    "accept_header": "image/avif,image/webp,image/png,image/jpeg,*/*;q=0.8"
   }
  ],
  "always": {
   "accept-language": "ko-KR,ko;q=0.9,en;q=0.8",
   "redirect": "manual",
   "method": "GET",
   "user-agent": "absent (not overridden)"
  }
 },

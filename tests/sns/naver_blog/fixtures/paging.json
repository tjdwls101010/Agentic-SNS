{
 "about": "Paging, windows and stops (appendix A 33-40, 53-55, 62, and the plan's stop table). A scenario serves pages in order to one walk. policy: plain (page+1; a short page ends it; a ceiling makes a short page near it capped), marked (the page names the last page: marker), single (one page). A page is {count, start} (ids r<start>.. in order), {count, repeat} (consecutive runs), {ids}, {dated: [KST minutes or null]} (ids d1, d2.. across the scenario), optional marker and reported_total, or {error: {code, reason}} with kept records for a restriction. options: limit (records to show), since/until (KST days), monotonic (the surface is newest first). expect: shown ids or shown_count, stop_reason, exit, pending (read, not shown, kept in the handle), pages_fetched, reported_total, undated. continue resumes from the first walk's state.",
 "scenarios": [
  {
   "name": "short-page-ends",
   "item": "33",
   "policy": {
    "pagination": "plain",
    "page_size": 30,
    "ceiling": null
   },
   "options": {
    "limit": 100
   },
   "pages": [
    {
     "count": 30,
     "start": 1
    },
    {
     "count": 12,
     "start": 31
    }
   ],
   "expect": {
    "shown_count": 42,
    "stop_reason": "exhausted",
    "exit": 0,
    "pages_fetched": 2,
    "pending": 0
   }
  },
  {
   "name": "explicit-empty",
   "item": "38",
   "policy": {
    "pagination": "plain",
    "page_size": 30,
    "ceiling": null
   },
   "options": {
    "limit": 10
   },
   "pages": [
    {
     "count": 0,
     "start": 1
    }
   ],
   "expect": {
    "shown_count": 0,
    "stop_reason": "exhausted",
    "exit": 7,
    "pages_fetched": 1
   }
  },
  {
   "name": "post-search-short-at-1000",
   "item": "33",
   "fact": "Post search went short at position 1,000: near the ceiling a short page is the ceiling, not the end.",
   "policy": {
    "pagination": "plain",
    "page_size": 30,
    "ceiling": 1000
   },
   "options": {
    "limit": 2000
   },
   "pages": [
    {
     "count": 30,
     "repeat": 33
    },
    {
     "count": 10,
     "start": 991
    }
   ],
   "expect": {
    "shown_count": 1000,
    "stop_reason": "server_capped",
    "exit": 8,
    "pages_fetched": 34
   }
  },
  {
   "name": "tag-search-empty-at-990",
   "item": "33",
   "fact": "Tag search went empty at 990: one more page would cross the ceiling, so it is the ceiling.",
   "policy": {
    "pagination": "plain",
    "page_size": 30,
    "ceiling": 1000
   },
   "options": {
    "limit": 2000
   },
   "pages": [
    {
     "count": 30,
     "repeat": 33
    },
    {
     "count": 0,
     "start": 1
    }
   ],
   "expect": {
    "shown_count": 990,
    "stop_reason": "server_capped",
    "exit": 8,
    "pages_fetched": 34
   }
  },
  {
   "name": "full-page-on-the-ceiling",
   "item": "33",

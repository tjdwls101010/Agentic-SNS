  {
   "name": "window-closes-newest-first",
   "item": "37",
   "fact": "On a newest-first surface a page wholly older than --since closes the window; --until includes its whole KST day.",
   "policy": {
    "pagination": "plain",
    "page_size": 3,
    "ceiling": null
   },
   "options": {
    "limit": 100,
    "since": "2026-10-10",
    "until": "2026-10-15",
    "monotonic": true
   },
   "pages": [
    {
     "dated": [
      "2026-10-16T23:59",
      "2026-10-15T23:59",
      "2026-10-10T00:00"
     ]
    },
    {
     "dated": [
      "2026-10-09T23:59",
      "2026-10-08T00:00",
      "2026-10-07T00:00"
     ]
    }
   ],
   "expect": {
    "shown": [
     "d2",
     "d3"
    ],
    "stop_reason": "window_reached",
    "exit": 0,
    "pages_fetched": 2
   }
  },

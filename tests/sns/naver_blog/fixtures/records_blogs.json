 "new_surfaces": {
  "status": "Documentary field inventory, not executable raw/expect cases. Synthetic shapes from the shipped old CLI tests are in cli_responses.json with source lines; there are no local Naver captures in this P1 run. P4 must consume those fixtures. buddy_total is not a shipped route; the sympathy person list remains subject to S13/P3.",
  "surfaces": [
   {
    "op": "search_blogs",
    "path": "/api/search/v2/blog",
    "fact": "v2 blog search carries blogStatus, relationType and badges beside the card fields; the record is a Blog with the viewer's relation.",
    "fields": [
     "blogId",
     "blogName",
     "nickName",
     "blogStatus",
     "relationType",
     "badges"
    ]
   },
   {
    "op": "search_clips",
    "path": "/api/search/v1/moment",
    "fact": "Clip results include docNo (the permalink /<blogId>/clip/<docNo>), originTitle, playTime and momentNo; momentNo is not the permalink id.",
    "fields": [
     "docNo",
     "momentNo",
     "originTitle",
     "playTime",
     "blogId"
    ]
   },
   {
    "op": "popular_keywords",
    "path": "/api/v1/popular-keywords",
    "fact": "Twelve keywords with the date Naver computed them (keywordDate); a Keyword record keeps rank order.",
    "fields": [
     "keywordDate",
     "keyword",
     "rank"
    ]
   },
   {
    "op": "related_keywords",
    "path": "/api/related-keywords",
    "fact": "About fifteen related keywords for one keyword.",
    "fields": [
     "keyword"
    ]
   },
   {
    "op": "sympathy",
    "path": "/api/blogs/{blogId}/posts/{logNo}/sympathy-users",
    "fact": "sympathy yields exact totalCount and reactionCounts. The old implementation does not expose the owner-only person list; S13 requires fresh P3 reconnaissance before adding it.",
    "fields": [
     "totalCount",
     "reactionCounts"
    ]
   },
   {
    "op": "contents_count",
    "path": "/api/blogs/{blogId}/contents-count",
    "fact": "The blog's post and clip totals.",
    "fields": [
     "postCount",
     "momentCount"
    ]
   },
   {
    "op": "current_user",
    "path": "/api/current-user",
    "fact": "userId (the viewer's blog id), loggedIn, blogNo, networkBlocked, writeBlocked; idNo and baUserKey are viewer identifiers that never reach output or diagnostics.",
    "fields": [
     "userId",
     "loggedIn",
     "blogNo",
     "networkBlocked",
     "writeBlocked",
     "idNo",
     "baUserKey"
    ]
   },
   {
    "op": "feed",
    "path": "/api/blogs/{me}/feed/v1",
    "fact": "Page-numbered (totalCount, page), groupId filter; items carry groupId, relationType, buyWithMyOwnMoney, likeCount, commentCount, shareCount, isRss, briefContents.",
    "fields": [
     "totalCount",
     "page",
     "groupId",
     "relationType",
     "buyWithMyOwnMoney",
     "likeCount",
     "commentCount",
     "shareCount",
     "isRss",
     "briefContents"
    ]
   },
   {
    "op": "buddy_groups",
    "path": "/api/blogs/{me}/buddy-groups",
    "fact": "Neighbor groups carry blogId, blogNo, groupId and groupName; the shipped record does not assert a count.",
    "fields": [
     "blogId",
     "blogNo",
     "groupId",
     "groupName"
    ]
   },
   {
    "op": "buddy_total",
    "path": "/api/blogs/{me}/buddies/total-count",
    "fact": "How many neighbors.",
    "fields": [
     "totalCount"
    ],
    "status": "not in the shipped 35-route ledger; documentary observation only, no P4 route implied"
   },
   {
    "op": "followers",
    "path": "/api/blogs/{me}/me-buddies",
    "fact": "The blogs that added the viewer (pageNo).",
    "fields": [
     "pageNo",
     "blogId"
    ]
   },
   {
    "op": "monthly_issues",
    "path": "/api/thismonthblog/year-month-list",
    "fact": "The published issues (year, month).",
    "fields": [
     "year",
     "month"
    ]
   },
   {
    "op": "monthly_blogs",
    "path": "/api/thismonthblog/directory-blogid-list",
    "fact": "Six topics with blog ids for one issue (?year&month; none = latest).",
    "fields": [
     "directoryName",
     "blogIdList"
    ]
   },
   {
    "op": "monthly_profiles",
    "path": "/api/blogs/profiles/profile-relation-list",
    "fact": "The result.blogProfileAndRelationView list contains cards for blogIdList.",
    "fields": [
     "result.blogProfileAndRelationView"
    ]
   },
   {
    "op": "monthly_posts",
    "path": "/api/blogs/posts/popular-post-list",
    "fact": "Representative posts for a list of blog ids.",
    "fields": [
     "blogIdList"
    ]
   }
  ]
 }

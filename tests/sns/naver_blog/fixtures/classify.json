    "url": "https://m.blog.naver.com/api/blogs/me_blog/my-buddies",
    "body": "",
    "location": "https://nid.naver.com/nidlogin.login"
   },
   "outcome": {
    "code": 6,
    "reason": "transient"
   }
  },

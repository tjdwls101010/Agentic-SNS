{
  "about": "Finding a renamed query's successor (appendix A 32). A declared read has a variable signature: required names, optional names, and pinned values (userID = the profile the screen is about, query = the screen's search text); relay provider variables are ignored. A candidate fits when required <= its names <= required + optional and every pinned value matches. Successors are adopted only one-to-one: each lost query has exactly one unclaimed fitting candidate and no candidate fits two lost queries. Names claimed by declared queries are not candidates. A fitting candidate is adopted only after one replay shows the declared identity and role. Uncertainty stops with 'the skill needs an update' rather than a guess.",
  "signatures": {
    "profile.threads": {"required": ["userID", "first", "allow_page_info_for_lox_user"], "optional": ["after"], "pinned": {"userID": "profile"}, "role": "authored"},
    "profile.replies": {"required": ["userID", "first"], "optional": ["after"], "pinned": {"userID": "profile"}, "role": "authored"},
    "profile.reposts": {"required": ["userID", "first"], "optional": ["after"], "pinned": {"userID": "profile"}, "role": "reposted"},
    "search.posts": {"required": ["query", "search_surface", "recent"], "optional": ["tagID", "meta_place_id", "power_search_info", "trend_fbid", "after"], "pinned": {"query": "query"}}
  },
  "fits": [

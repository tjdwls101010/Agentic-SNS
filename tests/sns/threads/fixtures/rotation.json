     "variables": {"userID": "1000000001", "first": 10, "allow_page_info_for_lox_user": false, "after": null, "__relay_internal__pv__BarcelonaXrelayprovider": true}, "fits": true},
    {"name": "missing-required", "signature": "profile.threads", "context": {"profile": "1000000001"},
     "variables": {"userID": "1000000001", "first": 10}, "fits": false},
    {"name": "unknown-extra-name", "signature": "profile.replies", "context": {"profile": "1000000001"},
     "variables": {"userID": "1000000001", "first": 25, "include_reposts": true}, "fits": false},
    {"name": "other-profile", "signature": "profile.replies", "context": {"profile": "1000000001"},
     "variables": {"userID": "1000000002", "first": 25}, "fits": false},
    {"name": "pinned-value-unknown", "signature": "profile.replies", "context": {"profile": null},
     "variables": {"userID": "1000000001", "first": 25}, "fits": false},
    {"name": "search-pinned-query", "signature": "search.posts", "context": {"query": "example words"},
     "variables": {"query": "example words", "search_surface": "default", "recent": 0, "power_search_info": null}, "fits": true},
    {"name": "search-other-query", "signature": "search.posts", "context": {"query": "example words"},
     "variables": {"query": "different", "search_surface": "default", "recent": 0}, "fits": false}
  ],
  "matches": [
    {"name": "one-lost-one-candidate", "lost": ["profile.replies"], "claimed": ["BarcelonaProfileThreadsTabV2Query"], "context": {"profile": "1000000001"},
     "candidates": [
       {"name": "BarcelonaProfileThreadsTabV2Query", "variables": {"userID": "1000000001", "first": 25}},
       {"name": "BarcelonaProfileRepliesTabV2Query", "variables": {"userID": "1000000001", "first": 25}},
       {"name": "BarcelonaProfileHeaderQuery", "variables": {"userID": "1000000001", "include_header": true}}],
     "expected": {"matched": {"profile.replies": "BarcelonaProfileRepliesTabV2Query"}}},
    {"name": "two-candidates-refused", "lost": ["profile.replies"], "claimed": [], "context": {"profile": "1000000001"},
     "candidates": [
       {"name": "BarcelonaProfileRepliesTabV2Query", "variables": {"userID": "1000000001", "first": 25}},
       {"name": "BarcelonaProfileSomethingElseQuery", "variables": {"userID": "1000000001", "first": 25}}],
     "expected": {"matched": null}},
    {"name": "one-candidate-for-two-lost-refused", "lost": ["profile.replies", "profile.reposts"], "claimed": [], "context": {"profile": "1000000001"},
     "candidates": [
       {"name": "BarcelonaProfileTabV2Query", "variables": {"userID": "1000000001", "first": 25}}],
     "expected": {"matched": null}},

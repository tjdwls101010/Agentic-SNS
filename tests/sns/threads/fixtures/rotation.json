{
  "about": "A successor is the unique unclaimed read query whose argument-name set and root equal the lost definition. Provider argument names are ignored when definitions are read. Pinned variable values and required/optional signatures are not successor criteria. Replay decoding and profile role checks run before a provisional name is saved; an empty replay proves nothing.",
  "p4": {"status": "P4가 실행해야 함", "behavior": "successors 전부와 replays/roles 전부. 옛 rotation.json은 소비자 0; 후계 학습 CLI 테스트 test_cli_recovery.py:142,161 및 탭 검증 test_cli_profile.py:58,75도 이식."},
  "successors": [
    {"name": "unique-same-args-and-root", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "query"}], "expected": "BarcelonaProfileRepliesTabV2Query"},
    {"name": "different-root-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "feedData", "kind": "query"}], "expected": null},
    {"name": "extra-arg-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["userID", "first", "after", "extra"], "root": "mediaData", "kind": "query"}], "expected": null},
    {"name": "missing-arg-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["userID", "first"], "root": "mediaData", "kind": "query"}], "expected": null},
    {"name": "two-candidates-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "query"}, {"name": "BarcelonaOtherTabQuery", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "query"}], "expected": null},
    {"name": "claimed-name-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": ["BarcelonaProfileRepliesTabV2Query"], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "query"}], "expected": null},
    {"name": "mutation-kind-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "mutation"}], "expected": null},
    {"name": "mutation-named-query-refused", "lost": {"args": ["userID", "first", "after"], "root": "mediaData"}, "claimed": [], "candidates": [{"name": "BarcelonaProfileMutationTabQuery", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "query"}], "expected": null},
    {"name": "no-identity-signature-refused", "lost": {"args": [], "root": null}, "claimed": [], "candidates": [{"name": "BarcelonaProfileRepliesTabV2Query", "doc_id": "1234567890123456", "args": ["after", "first", "userID"], "root": "mediaData", "kind": "query"}], "expected": null}
  ],
  "replays": {
    "fact": "A matched successor is adopted (its name, id and providers saved) only after one replay under the new name: the reply must be a usable response, decode as the declared connection, carry the declared identity (a profile query's user pk equals the userID sent) and play the declared role. Any failure keeps the previous entry and adopts nothing.",
    "cases": [
      {"name": "adopt-after-good-replay", "operation": "profile.replies", "user_id": "1000000001",
       "replay": {"data": {"mediaData": {"edges": [{"node": {"thread_items": [{"post": {"pk": "3000000000000000301", "user": {"pk": "1000000001", "username": "example.author"}}}]}}], "page_info": {"has_next_page": false, "end_cursor": null}}}},
       "expected": {"adopted": true}},
      {"name": "replay-not-decodable", "operation": "profile.replies", "user_id": "1000000001",
       "replay": {"data": {"somethingElse": {"edges": []}}},
       "expected": {"adopted": false, "why": "shape_changed"}},
      {"name": "replay-is-another-list", "operation": "profile.replies", "user_id": "1000000001",
       "replay": {"data": {"mediaData": {"edges": [{"node": {"thread_items": [{"post": {"pk": "3000000000000000302", "user": {"pk": "1000000002", "username": "someone.else"}}}]}}], "page_info": {"has_next_page": false, "end_cursor": null}}}},
       "expected": {"adopted": false, "why": "role_mismatch"}},
      {"name": "replay-wrong-identity", "operation": "profile.page", "user_id": "1000000001",
       "replay": {"data": {"user": {"pk": "1000000002", "username": "someone.else"}}},
       "expected": {"adopted": false, "why": "identity"}},
      {"name": "replay-rejected", "operation": "profile.replies", "user_id": "1000000001",
       "replay": {"errors": [{"message": "execution error", "severity": "CRITICAL"}]},
       "expected": {"adopted": false, "why": "rejected_query"}},
      {"name": "empty-replay-not-adopted", "operation": "profile.replies", "user_id": "1000000001", "replay": {"data": {"mediaData": {"edges": [], "page_info": {"has_next_page": false, "end_cursor": null}}}}, "expected": {"adopted": false, "why": "empty-proves-nothing"}}
    ]
  },
  "roles": {
    "fact": "Every group must contain a post authored by the profile; repost tabs additionally require a reposted_post in every group. These use normalized records (author.id and reposted_post).",
    "cases": [
      {"name": "authored-ok", "role": "authored", "user_id": "1000000001", "groups": [[{"author": {"id": "1000000001"}}], [{"author": {"id": "1000000002"}}, {"author": {"id": "1000000001"}}]], "plays": true},
      {"name": "authored-other-list", "role": "authored", "user_id": "1000000001", "groups": [[{"author": {"id": "1000000001"}}], [{"author": {"id": "1000000002"}}]], "plays": false},
      {"name": "reposted-ok", "role": "reposted", "user_id": "1000000001", "groups": [[{"author": {"id": "1000000001"}, "reposted_post": {"id": "3000000000000000300"}}]], "plays": true},
      {"name": "reposted-plain-posts", "role": "reposted", "user_id": "1000000001", "groups": [[{"author": {"id": "1000000001"}}]], "plays": false}
    ]
  }
}

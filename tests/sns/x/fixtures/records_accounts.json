    "legacy": {}
   },
   "expected": {
    "follower_count": null,
    "following_count": null,
    "post_count": null,
    "media_count": null,
    "like_count": null
   }
  },
  {
   "name": "paid-check-and-org-badge",
   "item": "18,33",
   "source": "code",
   "fact": "is_blue_verified is the paid subscription mark, not identity verification; verification.verified_type Business or Government is an organisation badge; verification.verified is the separate verified flag.",
   "parser": "account",
   "raw": {
    "__typename": "User",
    "rest_id": "1000000004",
    "core": {
     "screen_name": "org_example",
     "name": "Org Example"
    },
    "is_blue_verified": true,
    "verification": {
     "verified": false,
     "verified_type": "Business"
    },
    "legacy": {}
   },
   "expected": {
    "is_blue_verified": true,
    "is_verified": false,
    "verified_type": "Business"
   }
  },
  {
   "name": "no-badges",
   "item": "18",

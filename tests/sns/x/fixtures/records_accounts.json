{
 "about": "Account records (appendix A 18, 33). parser account: one raw X user result (as found at user_results.result or data.user.result) to one record, or a record with unavailable true for a UserUnavailable. expected lists only the fields the case is about; a field not named is free. Field names are the skill's own (shared with the threads skill where the concept is the same: username, full_name, follower_count, private, bio); X-only ideas keep X's meaning (is_blue_verified, verified_type). X sends newer grouped fields (core, avatar, location, privacy, verification, relationship_counts, tweet_counts, action_counts, website, banner, pinned_items, relationship_perspectives) and older legacy ones; the newer wins and legacy fills what it lacks. Counts X does not send are null (not reported), never 0. Times are UTC ISO. source: code (previous records.py), P2 (inferred, confirmed against captures). All people, ids and links are synthetic.",
 "cases": [
  {
   "name": "grouped-fields",
   "item": "18",
   "source": "code",
   "fact": "Identity and profile come from the grouped fields; the profile URL is built from the handle.",
   "parser": "account",
   "raw": {
    "__typename": "User",
    "rest_id": "1000000001",
    "core": {
     "screen_name": "example_author",
     "name": "Example Author",
     "created_at": "Wed Oct 10 20:19:24 +0000 2018"
    },
    "avatar": {
     "image_url": "https://pbs.twimg.com/profile_images/1/synthetic_normal.jpg"
    },
    "banner": {
     "image_url": "https://pbs.twimg.com/profile_banners/1000000001/1"
    },
    "location": {
     "location": "Example City"
    },
    "website": {
     "url": "https://example.org/about"
    },
    "privacy": {
     "protected": false
    },
    "relationship_counts": {
     "followers": 1200,
     "following": 300
    },
    "tweet_counts": {
     "tweets": 4500,
     "media_tweets": 80
    },
    "action_counts": {
     "favorites_count": 9000
    },
    "legacy": {}
   },
   "expected": {
    "id": "1000000001",
    "username": "example_author",
    "full_name": "Example Author",
    "created_at": "2018-10-10T20:19:24+00:00",
    "follower_count": 1200,
    "following_count": 300,
    "post_count": 4500,
    "media_count": 80,
    "like_count": 9000,
    "location": "Example City",
    "website": "https://example.org/about",
    "url": "https://x.com/example_author",
    "avatar_url": "https://pbs.twimg.com/profile_images/1/synthetic_normal.jpg",
    "banner_url": "https://pbs.twimg.com/profile_banners/1000000001/1",
    "private": false,
    "unavailable": false
   }
  },
  {
   "name": "legacy-fallback",
   "item": "18",
   "source": "code",
   "fact": "When the grouped fields are absent, legacy fills screen_name, name, created_at, followers_count, friends_count (following) and statuses_count (posts).",
   "parser": "account",
   "raw": {
    "__typename": "User",
    "rest_id": "1000000002",
    "legacy": {
     "screen_name": "legacy_person",
     "name": "Legacy Person",
     "created_at": "Mon Jan 02 03:04:05 +0000 2012",
     "followers_count": 15,
     "friends_count": 20,
     "statuses_count": 7
    }
   },
   "expected": {
    "id": "1000000002",
    "username": "legacy_person",
    "full_name": "Legacy Person",
    "created_at": "2012-01-02T03:04:05+00:00",
    "follower_count": 15,
    "following_count": 20,
    "post_count": 7
   }
  },
  {
   "name": "counts-not-sent-are-null",
   "item": "18,33",
   "source": "code",
   "fact": "A count X did not send is null (not reported), not 0.",
   "parser": "account",
   "raw": {
    "__typename": "User",
    "rest_id": "1000000003",

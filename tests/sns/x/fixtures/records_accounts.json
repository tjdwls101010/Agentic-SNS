  {
   "name": "bio-links-expanded",
   "item": "18",
   "source": "code",
   "fact": "The bio's t.co links are replaced by their destinations (profile_bio first, legacy description entities as fallback).",
   "parser": "account",
   "raw": {
    "__typename": "User",
    "rest_id": "1000000006",
    "core": {
     "screen_name": "bio_person",
     "name": "Bio"
    },
    "profile_bio": {
     "description": "Writing at https://t.co/AAAA1111 and more",
     "entities": {
      "description": {
       "urls": [
        {
         "url": "https://t.co/AAAA1111",
         "expanded_url": "https://blog.example.org/"
        }
       ]
      }
     }
    },
    "legacy": {}
   },
   "expected": {
    "bio": "Writing at https://blog.example.org/ and more"
   }
  },

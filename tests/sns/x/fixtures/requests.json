  "behavior": "headers.set 외 read_only, features, method, variables와 35개 배선 작업의 등록부 계약을 실행한다. 3개 미배선 작업 제거는 의도한 변경. Executed by tests/sns/x/test_requests.py."
 },
 "about": "What a request from the dedicated tab carries (appendix A 13, 29 and the planning session's measurement of the app's own requests on 2026-10-18). headers: each header the app sends and where its value comes from in the logged-in tab; method: when the app uses POST; read_only: which operations may ever be sent; features: how the features parameter is filled; variables: registry defaults and the arguments each wired surface sends (2026-10-19 snapshot). All values are synthetic; no real bearer, token or query id appears here.",
 "headers": {
  "item": "13",
  "source": "measured",
  "fact": "The app's GraphQL requests are XHR to https://x.com/i/api/graphql/<queryId>/<operationName> with exactly these headers; a request is not sent when any source is missing (no bearer in the modules, no ct0 cookie, no signature generator).",
  "set": {
   "authorization": "Bearer <the bearer string found in the app's modules>",
   "x-twitter-auth-type": "OAuth2Session",
   "x-csrf-token": "<the ct0 cookie>",
   "x-twitter-client-language": "<the store's session.language>",
   "x-twitter-active-user": "yes",
   "content-type": "application/json",
   "x-client-transaction-id": "<the app's own generator called with (host, path without query or fragment, method)>"
  },
  "polling_only": {
   "x-twitter-polling": "true"
  },
  "never": [
   "origin",
   "referer",
   "user-agent",
   "cookie"
  ],
  "missing_cases": [
   {
    "missing": "bearer",
    "expected": {
     "sent": false,
     "reason": "missing"
    }
   },
   {
    "missing": "ct0",
    "expected": {
     "sent": false,
     "reason": "login"
    }
   },
   {
    "missing": "generator",
    "expected": {
     "sent": false,
     "reason": "missing"
    }
   }
  ]
 },

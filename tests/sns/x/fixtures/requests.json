    "operationType": "query",
    "expected": "GET"
   },
   {
    "operation": "HomeLatestTimeline",
    "operationType": "query",
    "expected": "GET"
   },
   {
    "operation": "TweetDetail",
    "operationType": "query",
    "expected": "GET"
   }
  ]
 },

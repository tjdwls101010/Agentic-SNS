{
  "about": "Synthetic GraphQL bodies for search entities (appendix A 43) and About fields (44). Same case format as records_posts.json. About cases give bodies (one body_lines list per response) because About reads an overview and then one response per collection.",
  "cases": [
    {
      "name": "people-vertical",
      "item": "43",
      "fact": "An entity is a result-root node with __typename User, Page or Group and an id, a string name and a string url. In the people vertical a User is a person. verified is is_verified when it is a boolean, else null. Repeated ids appear once.",
      "parser": "search",
      "args": {
        "search_type": "people"
      },
      "body_lines": [
        {
          "data": {
            "serpResponse": {
              "results": {
                "edges": [
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "User",
                          "id": "500",
                          "name": "Sample Person",
                          "url": "https://www.facebook.com/sample.person",
                          "is_verified": true
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  },
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "User",
                          "id": "501",
                          "name": "Sample Person",
                          "url": "https://www.facebook.com/profile.php?id=501",
                          "is_verified": "no"
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  },
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "User",
                          "id": "500",
                          "name": "Sample Person",
                          "url": "https://www.facebook.com/sample.person",
                          "is_verified": true
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  },
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "User",
                          "id": "502",
                          "name": null,
                          "url": "https://www.facebook.com/x"
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  }
                ],
                "page_info": {
                  "has_next_page": true,
                  "end_cursor": "SCUR1"
                }
              }
            }
          }
        }
      ],
      "expected": {
        "records": [
          {
            "kind": "person",
            "id": "500",
            "name": "Sample Person",
            "url": "https://www.facebook.com/sample.person",
            "verified": true
          },
          {
            "kind": "person",
            "id": "501",
            "verified": null
          }
        ],
        "page_info": {
          "has_next_page": true,
          "end_cursor": "SCUR1"
        },
        "issues": []
      }
    },

#!/usr/bin/env python3
"""Deterministic process-boundary replies; never contacts a browser.

Fixtures are keyed by the whole normalized request (host + path + sorted query), so a
command that asks for the wrong page or the wrong parameter finds no fixture and fails
loudly, instead of being handed the answer to a question it did not ask.
"""
import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import parse_qsl

source = sys.argv[-1]
args = json.JSONDecoder().raw_decode(source.removeprefix('const ARGS = '))[0]
snippet = re.search(r'// naver-blog-snippet: (\w+)', source)[1]

host, path, query = args.get('host'), args.get('path'), args.get('query') or ''
key = host + path + ('?' + '&'.join(f'{k}={v}' for k, v in sorted(parse_qsl(query))) if query else '')

log = os.environ.get('NAVER_BLOG_FAKE_LOG')
if log:
    with Path(log).open('a') as stream:
        stream.write(json.dumps({'snippet': snippet, 'host': host, 'path': path,
                                 'query': query, 'key': key}, ensure_ascii=False) + '\n')

root = Path(os.environ['NAVER_BLOG_FIXTURES'])
records = []
for name in sorted(root.glob('*.ndjson')):
    records += [json.loads(line) for line in name.read_text(encoding='utf-8').splitlines() if line.strip()]

matches = [record for record in records if record['key'] == key]
if not matches:
    raise SystemExit('No fixture for: ' + key)
envelope = dict(matches[0]['envelope'])
if 'body_file' in envelope:
    envelope['body'] = (root / envelope.pop('body_file')).read_text(encoding='utf-8')
envelope.setdefault('url', 'https://' + host + path)
envelope.setdefault('body', '')
envelope.setdefault('location', None)
print(json.dumps(envelope, ensure_ascii=False))

  {
   "name": "repost-row",
   "item": "20",
   "source": "code + decision (P1, attribution; plan A20 updated)",
   "fact": "A repost row is the reposter's act: its id and created_at are the repost's own (when it was reposted), its author is the reposter, its url is the original's, and the original is the reposted_post record that holds the words, media and counts. Decision (P1): the row's own text and counts are left empty instead of copying the original's, so a reposter is never shown as the writer of words they did not write (X's own legacy text on a repost is a clipped 'RT @...' preview).",
   "parser": "post",
   "raw": {
    "__typename": "Tweet",
    "rest_id": "1850000000000000014",
    "core": {
     "user_results": {
      "result": {
       "$user": "C"
      }
     }
    },
    "legacy": {
     "full_text": "RT @example_author: Original words that X clipped…",
     "created_at": "Fri Oct 16 08:00:00 +0000 2026",
     "retweet_count": 50,
     "favorite_count": 0,
     "entities": {},
     "retweeted_status_result": {
      "result": {
       "__typename": "Tweet",
       "rest_id": "1850000000000000001",
       "core": {
        "user_results": {
         "result": {
          "$user": "A"
         }
        }
       },
       "legacy": {
        "full_text": "Original words that X clipped in the repost preview",
        "created_at": "Thu Oct 15 10:00:00 +0000 2026",
        "retweet_count": 50,
        "favorite_count": 400,
        "entities": {}
       }
      }
     }
    }
   },
   "expected": {
    "id": "1850000000000000014",
    "author": {
     "username": "third_person"
    },
    "created_at": "2026-10-16T08:00:00+00:00",
    "url": "https://x.com/example_author/status/1850000000000000001",
    "text": "",
    "like_count": null,
    "repost_count": null,
    "reposted_post": {
     "id": "1850000000000000001",
     "author": {
      "username": "example_author"
     },
     "created_at": "2026-10-15T10:00:00+00:00",
     "text": "Original words that X clipped in the repost preview",
     "like_count": 400,
     "repost_count": 50
    }
   }

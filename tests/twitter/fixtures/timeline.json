  {
   "name": "branch-cursor-in-module",
   "item": "23,24",
   "source": "code+P2",
   "fact": "A ShowMore cursor inside a module marks a collapsed branch that can be read further (R2 confirms the replay); it is kept with its module, never followed by itself.",
   "instructions": [
    {
     "type": "TimelineAddEntries",
     "entries": [
      {
       "entryId": "conversationthread-1850000000000000030",
       "content": {
        "entryType": "TimelineTimelineModule",
        "items": [
         {
          "entryId": "conversationthread-1850000000000000030-tweet-1850000000000000030",
          "item": {
           "itemContent": {
            "itemType": "TimelineTweet",
            "tweet_results": {
             "result": {
              "$post": "1850000000000000030"
             }
            }
           }
          }
         },
         {
          "entryId": "conversationthread-1850000000000000030-cursor-showmore-1",
          "item": {
           "itemContent": {
            "itemType": "TimelineTimelineCursor",
            "cursorType": "ShowMore",
            "value": "SHOWCUR1"
           }
          }
         }
        ]
       }
      }
     ]
    }
   ],
   "expected": {
    "entries": [
     [
      "post",
      "1850000000000000030",
      "conversationthread-1850000000000000030",
      0,
      false
     ],
     [
      "branch",
      "SHOWCUR1",
      "conversationthread-1850000000000000030",
      1,
      false
     ]
    ],
    "branches": [
     {
      "module": "conversationthread-1850000000000000030",
      "cursor_type": "ShowMore",
      "value": "SHOWCUR1"
     }
    ]
   }
  },

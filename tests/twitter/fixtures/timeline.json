  {
   "name": "trends-and-events",
   "item": "26",
   "source": "code",
   "fact": "TimelineTrend items are trends (name, trendMetadata.domainContext and metaDescription, the item's url); TimelineEventSummary items are events; a promoted trend is an ad.",

 "explore": {
  "item": "26",
  "source": "code",
  "fact": "ExplorePage (root data.explore_page.body) names each Explore tab's timeline in timelines[] ({id: tab, timeline: {id}}); a tab other than the default is read with GenericTimelineById(timelineId) — a second request; the default tab's first page is already in initialTimeline.timeline.timeline.instructions. A tab ExplorePage does not name is a shape change.",
  "body": {
   "initialTimeline": {
    "id": "foryou",
    "timeline": {
     "timeline": {
      "instructions": [
       {
        "type": "TimelineAddEntries",
        "entries": []
       }
      ]
     }
    }
   },
   "timelines": [
    {
     "id": "trending",
     "timeline": {
      "id": "VGltZWxpbmVTWU5USDE="
     }
    },
    {
     "id": "news",
     "timeline": {
      "id": "VGltZWxpbmVTWU5USDI="
     }
    }
   ]
  },
  "cases": [
   {
    "tab": "foryou",
    "expected": {
     "requests": 1,
     "instructions_from": "initialTimeline"
    }
   },
   {
    "tab": "trending",
    "expected": {
     "requests": 2,
     "timeline_id": "VGltZWxpbmVTWU5USDE="
    }
   },
   {
    "tab": "sports",
    "expected": {
     "error": "shape_changed"
    }
   }
  ]
 }
}

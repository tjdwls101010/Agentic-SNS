    {
     "type": "TimelineAddEntries",
     "entries": [
      {
       "entryId": "trend-1",
       "content": {
        "itemContent": {
         "itemType": "TimelineTrend",
         "name": "#SyntheticTopic",
         "trendMetadata": {
          "domainContext": "Technology · Trending",
          "metaDescription": "12.3K posts"
         },
         "url": {
          "url": "twitter://search/?query=%23SyntheticTopic"
         }
        }
       }
      },
      {
       "entryId": "trend-2",
       "content": {
        "itemContent": {
         "itemType": "TimelineTrend",
         "name": "Sponsored Thing",
         "promotedMetadata": {
          "advertiser_results": {}
         },
         "trendMetadata": {}
        }
       }
      },
      {
       "entryId": "stories-1",
       "content": {
        "itemContent": {
         "itemType": "TimelineEventSummary",
         "title": "A synthetic event",

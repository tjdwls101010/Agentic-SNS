   "instructions": [
    {
     "type": "TimelineAddEntries",
     "entries": [
      {
       "entryId": "profile-conversation-1850000000000000010",
       "content": {
        "entryType": "TimelineTimelineModule",
        "items": [
         {
          "entryId": "profile-conversation-1850000000000000010-tweet-1850000000000000010",
          "item": {
           "itemContent": {
            "itemType": "TimelineTweet",
            "tweet_results": {
             "result": {
              "$post": "1850000000000000010"
             }
            }
           }
          }
         },
         {
          "entryId": "profile-conversation-1850000000000000010-tweet-1850000000000000011",
          "item": {
           "itemContent": {
            "itemType": "TimelineTweet",
            "tweet_results": {
             "result": {
              "$post": "1850000000000000011"
             }
            }
           }
          }
         }
        ]
       }
      }
     ]
    }
   ],
   "expected": {
    "entries": [
     [
      "post",
      "1850000000000000010",
      "profile-conversation-1850000000000000010",
      0,
      false
     ],
     [
      "post",
      "1850000000000000011",
      "profile-conversation-1850000000000000010",
      1,
      false
     ]
    ]
   }
  },
  {
   "name": "terminate-bottom-ends",
   "item": "22",
   "source": "code",
   "fact": "TimelineTerminateTimeline with direction Bottom (or none) ends the timeline; Top does not.",
   "instructions": [
    {
     "type": "TimelineAddEntries",
     "entries": [
      {
       "entryId": "tweet-1850000000000000006",
       "content": {
        "itemContent": {
         "itemType": "TimelineTweet",
         "tweet_results": {
          "result": {
           "$post": "1850000000000000006"
          }
         }
        }
       }
      }
     ]
    },
    {
     "type": "TimelineTerminateTimeline",
     "direction": "Top"
    },
    {
     "type": "TimelineTerminateTimeline",
     "direction": "Bottom"
    }
   ],
   "expected": {
    "entries": [
     [
      "post",
      "1850000000000000006",
      null,
      0,
      false
     ]
    ],
    "terminated": true
   }
  },
  {
   "name": "terminate-top-only",
   "item": "22",
   "source": "code",
   "fact": "Only a Top termination does not end the timeline.",
   "instructions": [
    {
     "type": "TimelineTerminateTimeline",
     "direction": "Top"
    }
   ],
   "expected": {
    "entries": [],
    "terminated": false
   }
  },
  {
   "name": "replace-entry-cursor",
   "item": "22",
   "source": "code",
   "fact": "A later page can send its Bottom cursor in TimelineReplaceEntry (one entry).",
   "instructions": [
    {
     "type": "TimelineAddEntries",
     "entries": [
      {
       "entryId": "tweet-1850000000000000007",
       "content": {
        "itemContent": {
         "itemType": "TimelineTweet",
         "tweet_results": {
          "result": {
           "$post": "1850000000000000007"
          }
         }
        }
       }
      }
     ]
    },
    {
     "type": "TimelineReplaceEntry",
     "entry_id_to_replace": "cursor-bottom-0",
     "entry": {
      "entryId": "cursor-bottom-0",
      "content": {
       "entryType": "TimelineTimelineCursor",
       "cursorType": "Bottom",
       "value": "BOTCUR2"
      }
     }
    }
   ],
   "expected": {
    "entries": [
     [
      "post",
      "1850000000000000007",
      null,
      0,
      false
     ]
    ],
    "bottom": "BOTCUR2"
   }
  },

#!/usr/bin/env python3
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from fake_data import response

code = sys.argv[-1]
args = json.loads(code.split("const ARGS = ", 1)[1].split(";\n", 1)[0])
if log := os.environ.get("TWITTER_FAKE_LOG"):
    with open(log, "a") as stream:
        stream.write(json.dumps({k: v for k, v in args.items() if k in ("op", "variables", "method")}) + "\n")
if "// twitter-snippet: cookie" in code:
    status, body = 200, {"ct0": "synthetic", "twid": "u%3D100"}
elif "// twitter-snippet: graphql" in code:
    status, body = response(args["op"], args["variables"], os.environ.get("TWITTER_FAKE_SCENARIO", "normal"))
else:
    status, body = 500, {}
print(
    json.dumps(
        {
            "status": status,
            "url": "https://x.com/",
            "body": json.dumps(body),
            "ratelimit": {"limit": 500, "remaining": 490, "reset": int(time.time()) + 900},
        }
    )
)

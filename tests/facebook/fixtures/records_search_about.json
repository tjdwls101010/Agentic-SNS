      "args": {
        "search_type": "pages"
      },
      "body_lines": [
        {
          "data": {
            "serpResponse": {
              "results": {
                "edges": [
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "User",
                          "id": "600",
                          "name": "Example Page",
                          "url": "https://www.facebook.com/examplepage",
                          "is_verified": false
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"

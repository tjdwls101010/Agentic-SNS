            "verified": false
          }
        ],
        "issues": []
      }
    },
    {
      "name": "groups-vertical-keeps-only-groups",
      "item": "43",
      "fact": "Group is unambiguous. The groups vertical drops non-Group nodes (nested users are members or admins, not results).",
      "parser": "search",
      "args": {
        "search_type": "groups"
      },
      "body_lines": [
        {
          "data": {
            "serpResponse": {
              "results": {
                "edges": [
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "Group",
                          "id": "700",
                          "name": "Example Group",
                          "url": "https://www.facebook.com/groups/700/"
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  },
                  {
                    "rendering_strategy": {
                      "view_model": {
                        "profile": {
                          "__typename": "User",
                          "id": "701",
                          "name": "An Admin",
                          "url": "https://www.facebook.com/an.admin"
                        }
                      }
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  }
                ],
                "page_info": {
                  "has_next_page": false,
                  "end_cursor": null
                }
              }
            }
          }
        }
      ],
      "expected": {
        "records": [
          {
            "kind": "group",
            "id": "700",
            "name": "Example Group",
            "url": "https://www.facebook.com/groups/700/"
          }
        ],
        "issues": []
      }
    },
    {
      "name": "top-search-index-order-and-no-authors",
      "item": "43",
      "fact": "Only result wrappers (node, result, entity, profile, group, page, user, rendering_strategy, view_model) are followed; a Story, Comment or feedback-bearing node is not entered, so a post's author is not an entity. A top search keeps the connection's index order even when deferred pieces arrive out of order.",
      "parser": "search",
      "args": {
        "search_type": "top"
      },
      "body_lines": [
        {
          "data": {
            "serpResponse": {
              "results": {
                "edges": [
                  {
                    "rendering_strategy": {
                      "view_model": null
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  },
                  {
                    "rendering_strategy": {
                      "view_model": null
                    },
                    "node": {
                      "role": "ENTITY_USER",
                      "__typename": "SearchRenderable"
                    }
                  },
                  {
                    "node": {
                      "__typename": "Story",
                      "feedback": {
                        "id": "SF1"
                      },
                      "creation_time": 1767225600,
                      "message": {
                        "text": "a post in search"
                      },
                      "actors": [
                        {
                          "__typename": "User",
                          "id": "800",
                          "name": "Post Author",
                          "url": "https://www.facebook.com/post.author"
                        }
                      ]
                    }
                  }
                ],
                "page_info": {
                  "has_next_page": true,
                  "end_cursor": "SCUR2"
                }
              }
            }
          }
        },
        {
          "path": [
            "serpResponse",
            "results",
            "edges",
            1,
            "rendering_strategy"
          ],
          "data": {
            "view_model": {
              "profile": {
                "__typename": "Page",
                "id": "610",
                "name": "Second Result Page",
                "url": "https://www.facebook.com/secondpage"
              }
            }
          }
        },
        {
          "path": [
            "serpResponse",
            "results",
            "edges",
            0,
            "rendering_strategy"
          ],
          "data": {
            "view_model": {
              "profile": {
                "__typename": "User",
                "id": "510",
                "name": "First Result Person",
                "url": "https://www.facebook.com/first.person"
              }
            }
          }
        }
      ],
      "expected": {
        "records": [
          {
            "kind": "person",
            "id": "510"
          },
          {
            "kind": "page",
            "id": "610"
          },
          {
            "id": "SF1",
            "text": "a post in search",
            "author_name": "Post Author",
            "source": "search"
          }
        ],
        "page_info": {
          "has_next_page": true,
          "end_cursor": "SCUR2"
        },
        "issues": []
      }
    },

    {
      "name": "about-overview-collections",
      "item": "19,44",
      "fact": "The About overview (collectionToken null) lists all_collections.nodes [{name, id}] in response order; a node without a string name and id is skipped; ids appear once.",
      "parser": "about_collections",
      "args": {},
      "body_lines": [
        {
          "data": {
            "user": {
              "about_app_sections": {
                "nodes": [
                  {
                    "all_collections": {
                      "nodes": [
                        {
                          "name": "Work and education",
                          "id": "COL_WORK"
                        },
                        {
                          "name": "Places lived",
                          "id": "COL_PLACES"
                        },
                        {
                          "name": "Broken",
                          "id": 5
                        },
                        {
                          "name": "Work and education",
                          "id": "COL_WORK"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "expected": {
        "collections": [
          {
            "name": "Work and education",
            "id": "COL_WORK"
          },
          {
            "name": "Places lived",
            "id": "COL_PLACES"
          }
        ]
      }
    },
    {
      "name": "about-fields-across-collections",
      "item": "44",
      "fact": "Fields are profile_fields.nodes[] of a node carrying field_section_type (locale-independent): title.text, field_type, link_url. They dedupe on (section, text); the same text in another section is kept. collection is the viewer-language name of the tab it came from, null for the overview.",
      "parser": "about",
      "args": {
        "profile_id": "4",
        "collection_names": [
          null,
          "Work and education"
        ]
      },
      "bodies": [
        [
          {
            "data": {
              "user": {
                "about_app_sections": {
                  "nodes": [
                    {
                      "activeCollections": {
                        "nodes": [
                          {
                            "style_renderer": {
                              "profile_field_sections": [
                                {
                                  "field_section_type": "overview",
                                  "profile_fields": {
                                    "nodes": [
                                      {
                                        "title": {
                                          "text": "Works at Example Co"
                                        },
                                        "field_type": "work",
                                        "link_url": "https://www.facebook.com/exampleco"
                                      },
                                      {
                                        "title": {
                                          "text": "Lives in Example City"
                                        },
                                        "field_type": "current_city"
                                      },
                                      {
                                        "title": null
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        ],
        [
          {
            "data": {
              "user": {
                "about_app_sections": {
                  "nodes": [
                    {
                      "activeCollections": {
                        "nodes": [
                          {
                            "style_renderer": {
                              "profile_field_sections": [
                                {
                                  "field_section_type": "work",
                                  "profile_fields": {
                                    "nodes": [
                                      {
                                        "title": {
                                          "text": "Works at Example Co"
                                        },
                                        "field_type": "work"
                                      },
                                      {
                                        "title": {
                                          "text": "Works at Example Co"
                                        },
